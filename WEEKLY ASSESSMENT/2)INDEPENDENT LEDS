// C++ code
//
int led1=10,led2=6;
int flag=0;
unsigned long time=0;
void setup()
{
  pinMode(led1, OUTPUT);
  pinMode(led2, OUTPUT);
  digitalWrite(led1,LOW);
  digitalWrite(led2,LOW);
}

void loop()
{

  if(flag==0){
    digitalWrite(led1,HIGH);
    digitalWrite(led2,LOW);
    flag=1;
    time=millis();
  }
  else if(flag==1){
    if(millis()-time>1000){
      digitalWrite(led1,LOW);
      flag=2;
    }
  }
  else if(flag==2){
    digitalWrite(led2,HIGH);
    time=millis();
    flag=3;
  }
  else if(flag==3){
    if(millis()-time>=3000){
      digitalWrite(led2,LOW);
      flag=0;
    }
    
  }
    
}
  
